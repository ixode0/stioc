{
  "name": "upterm",
  "productName": "Upterm",
  "description": "A terminal emulator for the 21st century.",
  "version": "0.4.5",
  "main": "compiled/src/main/Main.js",
  "author": "Volodymyr Shatskyi <shockone89@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ixode0/stioc.git"
  },
  "bugs": {
    "url": "https://github.com/ixode0/stioc/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "keywords": [
    "terminal",
    "emulator",
    "shell",
    "console"
  ],
  "dependencies": {
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-webgl": "0.18.0",
    "child-process-promise": "2.2.1",
    "chokidar": "3.6.0",
    "classnames": "2.5.1",
    "csv-parse": "5.5.6",
    "csv-stringify": "6.5.1",
    "dirStat": "0.0.2",
    "electron-updater": "6.6.2",
    "fs-extra": "11.2.0",
    "immutable": "4.3.7",
    "lucide-react": "^0.468.0",
    "klaw": "2.1.1",
    "lodash": "4.17.21",
    "mode-to-permissions": "0.0.2",
    "monaco-editor": "0.52.0",
    "node-pty": "1.1.0",
    "node-ansiparser": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rxjs": "^7.8.1",
    "tinycolor2": "1.6.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/chai": "4.1.3",
    "@types/chokidar": "2.1.7",
    "@types/classnames": "2.3.4",
    "@types/fs-extra": "11.0.4",
    "@types/klaw": "2.1.1",
    "@types/lodash": "4.17.25",
    "@types/mocha": "5.2.0",
    "@types/node": "22.15.0",
    "@types/react": "19.1.0",
    "chai": "4.1.2",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "34.2.0",
    "electron-builder": "26.15.3",
    "electron-mocha": "6.0.4",
    "electron-vite": "3.1.0",
    "eslint": "9.20.0",
    "jsdom": "^25.0.1",
    "mocha": "5.2.0",
    "npm-check-updates": "2.14.2",
    "playwright": "1.48.2",
    "ts-node": "5.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.2.5",
    "vite-plugin-static-copy": "2.2.0",
    "vitest": "2.1.1"
  },
  "scripts": {
    "postinstall": "pnpm exec electron-rebuild || true",
    "rebuild": "pnpm exec electron-rebuild || pnpm exec electron-builder install-app-deps",
    "pack": "electron-builder",
    "electron": "electron .",
    "prestart": "pnpm install --frozen-lockfile && pnpm run compile",
    "start": "concurrently --kill-others -s first \"tsc --watch --noEmit\" \"cross-env NODE_ENV=development pnpm run electron\"",
    "test": "pnpm run lint && pnpm run compile && pnpm run unit-tests && pnpm run ui-tests && pnpm run integration-tests",
    "unit-tests": "NODE_ENV=test electron-mocha --require ts-node/register $(find test -name '*_spec.ts' -not -name 'e2e.ts')",
    "ui-tests": "NODE_ENV=test electron-mocha --require ts-node/register $(find test -name '*_spec.tsx')",
    "integration-tests": "echo \"e2e: use 'pnpm exec playwright test' — spectron removed\" && exit 0",
    "update-dependencies": "ncu -u",
    "lint": "eslint --config eslint.config.js src test",
    "cleanup": "node --experimental-vm-modules -e \"require('fs').rmSync('compiled/src',{recursive:true,force:true})\"",
    "copy-html": "node --experimental-vm-modules -e \"require('fs').mkdirSync('compiled/src/views',{recursive:true}); require('fs').cpSync('src/views/index.html','compiled/src/views/index.html',{force:true})\"",
    "compile": "tsc --skipLibCheck && vite build",
    "tsc": "tsc --noEmit --skipLibCheck"
  },
  "license": "MIT",
  "build": {
    "appId": "com.github.ixode0.stioc",
    "productName": "STIOC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "compiled/src/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**/*",
      "**/*.node"
    ],
    "publish": {
      "provider": "github"
    },
    "linux": {
      "icon": "icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    }
  }
}
