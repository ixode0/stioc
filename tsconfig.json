{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "compiled/src",
    "inlineSourceMap": true,
    "lib": ["ES2022", "dom"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "typings",
    "test",
    "compiled",
    "vite.config.ts",
    "eslint.config.js"
  ]
}
